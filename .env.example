# Application
APP_NAME=Appointment Booking API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Database (required in production)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/appointment_booking

# JWT (required in production)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
FRONTEND_ORIGIN=http://localhost:3000
